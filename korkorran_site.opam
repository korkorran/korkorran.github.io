opam-version: "2.0"
synopsis: "Static site generator for korkorran.github.io"
description:
  "The YOCaml program that builds korkorran.github.io: articles, pages, an index and syndication feeds."
maintainer: ["frederic.ln.lang@gmail.com"]
authors: ["Frederic Lang"]
license: "MIT"
homepage: "https://github.com/korkorran/korkorran.github.io"
bug-reports: "https://github.com/korkorran/korkorran.github.io/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.1.1"}
  "yocaml" {>= "3.0.0"}
  "yocaml_unix" {>= "3.0.0"}
  "yocaml_yaml" {>= "3.0.0"}
  "yocaml_markdown" {>= "3.0.0"}
  "yocaml_jingoo" {>= "3.0.0"}
  "yocaml_syndication" {>= "3.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
